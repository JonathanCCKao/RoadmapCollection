# ====================================================================
#  交換機專案甘特圖參數設定檔 (Settings Configuration)
#  提示：此檔案為公開設定，不包含任何帳號 Token 憑證，可安心備份至 GitHub
# ====================================================================

# Confluence 伺服器網址
CONFLUENCE_URL=https://wiki.moxa.com

# 資料來源的 Confluence 網頁 Page ID
SOURCE_PAGE_ID=125669085

# 甘特圖寫入的目的網頁 Page ID (預設與 SOURCE_PAGE_ID 相同)
TARGET_PAGE_ID=125669085

# 時間軸的最小顯示刻度: quarterly (季度) 或 monthly (月份)
TIMELINE_SCALE=quarterly

# 甘特圖橫向拉展的縮放倍率 (預設為 5，專案多時建議設大)
ZOOM_FACTOR=5

# 繪圖渲染引擎: plantuml (專業版) 或 mermaid
RENDER_MODE=plantuml
